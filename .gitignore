# Local developer tools (F9 reload, F11 probes, step tracing). Loaded in game only on the
# developer's machine through extra_folders; never published or packaged
dev/

# Local design/research notes and the offline smoke test: developer-only, not published
docs/
tools/

# SDK install kit: third-party downloads and backups of game files
_install/
_backup/

# Build output (tools/build_sdkmod.ps1)
dist/

# Python
__pycache__/
*.pyc

# Raw in-game probe dumps (large, machine-specific); probe_attributes.txt stays as reference
docs/data/probe_output*.txt

# Claude Code local settings
.claude/
